<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 收短信（危险权限，运行时/root 授予） -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <!-- 从 content://sms 读取刚落库的短信正文（MIUI/HyperOS 上 pdus 是 Supplier，
         getMessagesFromIntent 强转会抛 ClassCastException，只能改为查库） -->
    <uses-permission android:name="android.permission.READ_SMS" />
    <!-- 转发到 webhook -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 开机自启 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 常驻前台服务 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- 常驻通知（Android 13+ 需要运行时授予） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 请求忽略电池优化，减少被系统冻结 */
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:allowBackup="false"
        android:label="短信转发"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.DarkActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            不要在这里声明 android:permission="android.permission.BROADCAST_SMS"。
            该权限是 signature 级；在 MIUI/HyperOS 上，真实短信广播虽由 system(uid 1000)
            发出，但会先经过安全中心 com.miui.securitycenter.remote 的动态接收器
            (priority 999) 再二次派发，带此权限的静态 receiver 会在投递阶段被系统拦下，
            导致 onReceive 永远不被调用（现象：测试发送正常，真实短信收不到）。
            伪造短信广播需构造合法 PDU，自用场景下风险可接受。
            priority 999 尽量第一时间拿到（有序广播）。
        -->
        <receiver
            android:name=".SmsReceiver"
            android:exported="true">
            <intent-filter android:priority="999">
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

        <!-- 开机自启：拉起常驻前台服务 -->
        <receiver
            android:name=".BootReceiver"
            android:enabled="true"
            android:exported="true"
            android:directBootAware="true">
            <intent-filter android:priority="1000">
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!-- 常驻服务：维持进程 + 动态注册 SMS_RECEIVED -->
        <service
            android:name=".KeepAliveService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

    </application>

</manifest>
